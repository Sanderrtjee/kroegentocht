{
  "name": "kroegentocht",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "workspaces": ["shared", "api", "web"],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w web && npm run build -w api",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "migrate": "npm run migrate:dev -w api",
    "seed": "npm run seed:dev -w api",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm run test:unit -w api",
    "test:unit": "npm run test:unit -w api",
    "test:integration": "npm run test:integration -w api",
    "testdb:up": "docker compose -f ops/compose.test.yaml up -d --wait",
    "testdb:down": "docker compose -f ops/compose.test.yaml down -v",
    "audit:ci": "npm audit --audit-level=high --omit=dev"
  }
}
